# Copy to .env and fill in your own local credentials.
# Load explicitly with: node --env-file=.env index.js
PORT=3001
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=

# Separate standard-rules instance. Set explicitly: legacy code defaults to 7688.
NEO4J_STANDARD_URI=bolt://localhost:7689
NEO4J_STANDARD_USER=neo4j
NEO4J_STANDARD_PASS=

# Optional absolute path; otherwise uses ../data/material_structure_mapping.json
# STRUCTURE_MAPPING_PATH=
